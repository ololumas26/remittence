# Copiar para .env e preencher. Nunca commitar o .env real (já está no .gitignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta "service_role" (Supabase Dashboard > Project Settings > API keys).
# Usada só no backend (admin_client) para o upload de documentos ignorar as
# Storage RLS policies e para a Admin API (ex: apagar contas no Auth).
# NUNCA expor esta chave ao frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de dados ---
# Obrigatória quando APP_ENV=production (a app recusa arrancar sem isto nesse caso).
# Connection string do Postgres, ex: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Ambiente ---
# "development" (default) ou "production".
APP_ENV=development

# --- CORS ---
# Domínios do frontend autorizados a chamar esta API a partir do browser,
# separados por vírgula. Vazio = nenhum origin permitido.
# Ex: ALLOWED_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
ALLOWED_ORIGINS=

# --- Logging ---
# DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO

# --- Geolocalização (bloqueio por país na submissão de remessas) ---
# Caminho para a base local do MaxMind GeoLite2 Country (.mmdb).
GEOIP_DB_PATH=geoip/GeoLite2-Country.mmdb
# Usada só para atualizar geoip/GeoLite2-Country.mmdb (ex: com geoipupdate).
# A app em runtime não precisa dela — só lê o ficheiro .mmdb local.
MAXMIND_LICENSE_KEY=

# --- Email (Resend) ---
# Chave de API do Resend (https://resend.com/api-keys) — sem isto, o email de "pedido de
# remessa criado" (ver RemittanceService.submit) fica só registado num aviso no log, nunca é
# enviado, mas a remessa em si continua a ser submetida normalmente.
RESEND_API_KEY=
# Remetente usado nesses emails — tem de ser um domínio verificado no Resend
# (https://resend.com/domains). Enquanto não verificares um domínio próprio, dá para testar com
# o remetente de sandbox do Resend, mas esse só entrega para o email da tua própria conta Resend.
RESEND_FROM_EMAIL=Sentchu <onboarding@resend.dev>
