# Copiar para .env e preencher. Nunca commitar o .env real (já está no .gitignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Base de dados ---
# Obrigatória quando APP_ENV=production (a app recusa arrancar sem isto nesse caso).
# Connection string do Postgres, ex: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Ambiente ---
# "development" (default) ou "production".
APP_ENV=development

# --- CORS ---
# Domínios do frontend autorizados a chamar esta API a partir do browser,
# separados por vírgula. Vazio = nenhum origin permitido.
# Ex: ALLOWED_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
ALLOWED_ORIGINS=

# --- Logging ---
# DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO

# --- Geolocalização (bloqueio por país na submissão de remessas) ---
# Caminho para a base local do MaxMind GeoLite2 Country (.mmdb).
GEOIP_DB_PATH=geoip/GeoLite2-Country.mmdb
# Usada só para atualizar geoip/GeoLite2-Country.mmdb (ex: com geoipupdate).
# A app em runtime não precisa dela — só lê o ficheiro .mmdb local.
MAXMIND_LICENSE_KEY=
